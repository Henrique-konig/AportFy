{
  "name": "aportfy",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard financeiro pessoal e de casal — dark mode, glassmorphism e dados em tempo real via Firebase.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools emulators:exec --only firestore --project aportfy-rules-test \"vitest run --config vitest.rules.config.js\"",
    "build:css": "tailwindcss -c tailwind.config.js -i tools/tailwind.css -o css/tailwind.css --minify",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Henrique-konig/AportFy.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Henrique-konig/AportFy/issues"
  },
  "homepage": "https://github.com/Henrique-konig/AportFy#readme",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "firebase": "^13.0.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^3.4.17",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0"
  }
}
