rules_version = '2';

// =========================================================
// AportFy — Regras de segurança do Firestore
//
// Modelo:
//   users/{userId}/**              -> só o dono (auth.uid == userId)
//   couples/{coupleId}             -> doc raiz, guarda só a lista de
//                                      membros (não é dado financeiro)
//   couples/{coupleId}/**          -> só quem está em "members"
//   couples/{coupleId}/joinRequests/{uid}
//                                  -> pedido de entrada: criado por quem quer
//                                     entrar, aprovado/recusado só pelo dono
//                                     do espaço (coupleId == uid do dono)
//
// Deploy: Firebase Console > Firestore Database > Regras > colar este
// arquivo > Publicar. Ou, com o Firebase CLI instalado e o projeto
// linkado (firebase use ecofy-c332d): `firebase deploy --only firestore:rules`.
//
// Entrada no espaço de casal: quem tem o código NÃO entra sozinho. Cria um
// pedido em joinRequests e só passa a ser membro quando o DONO do espaço
// aprova (a regra de update do doc raiz exige o pedido existir e só o dono
// pode adicionar membros). Membros só crescem, nunca encolhem.
//
// Validação dos dados: além de "quem pode gravar", cada coleção confere o
// formato do que é gravado (tipos, limites de valor e tamanho de texto). Assim
// um cliente alterado não consegue salvar lixo, valores absurdos ou textos
// gigantes. Coleções desconhecidas não aceitam gravação.
//
// E-mail verificado: só quem confirmou o e-mail pode pedir entrada num espaço
// de casal (o dono vê um e-mail que de fato pertence a quem pede).
//
// IMPORTANTE: estas regras precisam ser publicadas junto com o deploy do app
// que usa joinRequests (Firebase Console > Firestore > Regras > Publicar).
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Validação por coleção (usada no espaço pessoal e no do casal) ----------
    function isMoney(v) {
      return v is number && v >= 0 && v < 1000000000000;
    }
    function isText(v, max) {
      return v is string && v.size() <= max;
    }
    function isDateText(v) {
      return v is string && v.size() == 10;
    }
    function isOptionalDate(v) {
      return v == null || (v is string && v.size() <= 10);
    }

    function validTransaction(d) {
      return isText(d.description, 200) && d.description.size() > 0
          && isMoney(d.amount) && d.amount > 0
          && d.type in ['income', 'expense']
          && isText(d.category, 80)
          && isDateText(d.date);
    }
    function validGoal(d) {
      return isText(d.name, 120) && d.name.size() > 0
          && isMoney(d.targetAmount)
          && isMoney(d.currentAmount)
          && isOptionalDate(d.get('deadline', null));
    }
    function validInvestment(d) {
      return isText(d.ticker, 30) && d.ticker.size() > 0
          && isText(d.category, 40)
          && isMoney(d.quantity)
          && isMoney(d.avgPrice)
          && isMoney(d.currentPrice)
          && isOptionalDate(d.get('purchaseDate', null))
          && d.get('purchases', []).size() <= 5000
          && d.get('sales', []).size() <= 5000;
    }
    function validDividend(d) {
      return isText(d.ticker, 30) && d.ticker.size() > 0
          && isText(d.type, 30)
          && isMoney(d.amount)
          && isDateText(d.date);
    }
    function validBudget(d) {
      return isMoney(d.monthlyLimit);
    }
    function validRecurrence(d) {
      return isText(d.description, 200) && d.description.size() > 0
          && isMoney(d.amount) && d.amount > 0
          && d.type in ['income', 'expense']
          && isText(d.category, 80)
          && d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 31;
    }
    function validSettings(d) {
      return d.keys().size() <= 30;
    }
    function isDay(v) {
      return v is int && v >= 1 && v <= 31;
    }
    function validBill(d) {
      return isText(d.description, 200) && d.description.size() > 0
          && isMoney(d.amount) && d.amount > 0
          && isDateText(d.dueDate)
          && isText(d.category, 80)
          && d.paid is bool
          && isOptionalDate(d.get('paidAt', null))
          && d.get('recurring', false) is bool;
    }
    function validCard(d) {
      return isText(d.name, 60) && d.name.size() > 0
          && isMoney(d.limit)
          && isDay(d.closingDay)
          && isDay(d.dueDay);
    }
    function validCardPurchase(d) {
      return isText(d.cardId, 60) && d.cardId.size() > 0
          && isText(d.description, 200) && d.description.size() > 0
          && isMoney(d.amount) && d.amount > 0
          && d.installments is int && d.installments >= 1 && d.installments <= 72
          && isDateText(d.purchaseDate)
          && isText(d.category, 80);
    }
    function validCardInvoice(d) {
      return isText(d.cardId, 60)
          && d.month is string && d.month.size() == 7
          && d.paid is bool
          && isMoney(d.total)
          && d.get('transactionIds', []).size() <= 500;
    }
    function validPushToken(d) {
      return isText(d.token, 4096) && d.token.size() > 0
          && isText(d.get('userAgent', ''), 300);
    }
    function validDoc(collection, d) {
      return (collection == 'transactions' && validTransaction(d))
          || (collection == 'goals' && validGoal(d))
          || (collection == 'investments' && validInvestment(d))
          || (collection == 'dividends' && validDividend(d))
          || (collection == 'budgets' && validBudget(d))
          || (collection == 'recurrences' && validRecurrence(d))
          || (collection == 'settings' && validSettings(d))
          || (collection == 'bills' && validBill(d))
          || (collection == 'cards' && validCard(d))
          || (collection == 'cardPurchases' && validCardPurchase(d))
          || (collection == 'cardInvoices' && validCardInvoice(d));
    }

    // Perfil do usuário (coupleId, displayName, email) e suas coleções
    // pessoais (transactions, goals, investments, dividends, budgets,
    // recurrences, settings) — só o próprio dono acessa.
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
                             && isText(request.resource.data.get('displayName', ''), 120)
                             && isText(request.resource.data.get('email', ''), 320)
                             && isText(request.resource.data.get('coupleId', ''), 60)
                             && isText(request.resource.data.get('pendingCoupleId', ''), 60);

      match /{collection}/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
                               && (validDoc(collection, request.resource.data)
                                   || (collection == 'pushTokens' && validPushToken(request.resource.data)));
      }
    }

    // Espaço de casal.
    match /couples/{coupleId} {
      // Membros que entram numa atualização do doc raiz (novo array menos o antigo).
      function addedMembers() {
        return request.resource.data.members.removeAll(resource.data.members);
      }

      // Só o dono (coupleId == uid) e os membros leem o doc raiz. Quem não é
      // membro não consegue nem confirmar que um código existe por aqui.
      allow read: if request.auth != null
                   && (request.auth.uid == coupleId
                       || (resource != null && request.auth.uid in resource.data.members));

      // Só pode criar o PRÓPRIO espaço (coupleId == seu uid), e só com
      // ele mesmo como único membro inicial.
      allow create: if request.auth != null
                     && request.auth.uid == coupleId
                     && request.resource.data.members == [request.auth.uid];

      // O dono pode apagar o espaço quando é o único membro (exclusão da conta).
      allow delete: if request.auth != null
                     && request.auth.uid == coupleId
                     && resource.data.members == [request.auth.uid];

      // Só o DONO altera o doc raiz, só o campo "members", só de forma
      // aditiva, e só para incluir (a) ele mesmo ou (b) UM solicitante que
      // tenha um pedido de entrada aberto.
      allow update: if request.auth != null
                     && request.auth.uid == coupleId
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                     && request.resource.data.members.hasAll(resource.data.members)
                     && (
                       addedMembers().hasOnly([coupleId])
                       || (
                         addedMembers().size() == 1
                         && exists(/databases/$(database)/documents/couples/$(coupleId)/joinRequests/$(addedMembers()[0]))
                       )
                     );

      // Pedidos de entrada no espaço.
      match /joinRequests/{requesterUid} {
        // Cada pessoa cria só o PRÓPRIO pedido, pendente, para um espaço que
        // existe e do qual ainda não é membro.
        allow create: if request.auth != null
                       && request.auth.uid == requesterUid
                       && request.auth.token.email_verified == true
                       && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt'])
                       && request.resource.data.uid == requesterUid
                       && request.resource.data.status == 'pending'
                       && exists(/databases/$(database)/documents/couples/$(coupleId))
                       && !(request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members);

        // O solicitante vê o próprio pedido; o dono vê todos.
        allow read: if request.auth != null
                     && (request.auth.uid == requesterUid || request.auth.uid == coupleId);

        // O dono aprova ou recusa (muda só o status).
        allow update: if request.auth != null
                       && request.auth.uid == coupleId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                       && request.resource.data.status in ['approved', 'rejected'];

        // Solicitante (cancelar/encerrar) e dono (limpar) podem apagar.
        allow delete: if request.auth != null
                       && (request.auth.uid == requesterUid || request.auth.uid == coupleId);
      }

      // Dados financeiros reais do casal — só quem está em "members"
      // (os pedidos de entrada têm regras próprias acima).
      match /{collection}/{docId} {
        allow read, delete: if request.auth != null
                             && collection != 'joinRequests'
                             && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        allow create, update: if request.auth != null
                               && collection != 'joinRequests'
                               && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members
                               && validDoc(collection, request.resource.data);
      }
    }

    // Qualquer coisa fora dos padrões acima é negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
