rules_version = '2';

// =========================================================
// AportFy — Regras de segurança do Firestore
//
// Modelo:
//   users/{userId}/**              -> só o dono (auth.uid == userId)
//   couples/{coupleId}             -> doc raiz, guarda só a lista de
//                                      membros (não é dado financeiro)
//   couples/{coupleId}/**          -> só quem está em "members"
//   couples/{coupleId}/joinRequests/{uid}
//                                  -> pedido de entrada: criado por quem quer
//                                     entrar, aprovado/recusado só pelo dono
//                                     do espaço (coupleId == uid do dono)
//
// Deploy: Firebase Console > Firestore Database > Regras > colar este
// arquivo > Publicar. Ou, com o Firebase CLI instalado e o projeto
// linkado (firebase use ecofy-c332d): `firebase deploy --only firestore:rules`.
//
// Entrada no espaço de casal: quem tem o código NÃO entra sozinho. Cria um
// pedido em joinRequests e só passa a ser membro quando o DONO do espaço
// aprova (a regra de update do doc raiz exige o pedido existir e só o dono
// pode adicionar membros). Membros só crescem, nunca encolhem.
//
// IMPORTANTE: estas regras precisam ser publicadas junto com o deploy do app
// que usa joinRequests (Firebase Console > Firestore > Regras > Publicar).
// =========================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário (coupleId, displayName, email) e suas coleções
    // pessoais (transactions, goals, investments, dividends, budgets,
    // recurrences) — só o próprio dono acessa.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Espaço de casal.
    match /couples/{coupleId} {
      // Membros que entram numa atualização do doc raiz (novo array menos o antigo).
      function addedMembers() {
        return request.resource.data.members.removeAll(resource.data.members);
      }

      // Só o dono (coupleId == uid) e os membros leem o doc raiz. Quem não é
      // membro não consegue nem confirmar que um código existe por aqui.
      allow read: if request.auth != null
                   && (request.auth.uid == coupleId
                       || (resource != null && request.auth.uid in resource.data.members));

      // Só pode criar o PRÓPRIO espaço (coupleId == seu uid), e só com
      // ele mesmo como único membro inicial.
      allow create: if request.auth != null
                     && request.auth.uid == coupleId
                     && request.resource.data.members == [request.auth.uid];

      // Só o DONO altera o doc raiz, só o campo "members", só de forma
      // aditiva, e só para incluir (a) ele mesmo ou (b) UM solicitante que
      // tenha um pedido de entrada aberto.
      allow update: if request.auth != null
                     && request.auth.uid == coupleId
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                     && request.resource.data.members.hasAll(resource.data.members)
                     && (
                       addedMembers().hasOnly([coupleId])
                       || (
                         addedMembers().size() == 1
                         && exists(/databases/$(database)/documents/couples/$(coupleId)/joinRequests/$(addedMembers()[0]))
                       )
                     );

      // Pedidos de entrada no espaço.
      match /joinRequests/{requesterUid} {
        // Cada pessoa cria só o PRÓPRIO pedido, pendente, para um espaço que
        // existe e do qual ainda não é membro.
        allow create: if request.auth != null
                       && request.auth.uid == requesterUid
                       && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'status', 'createdAt'])
                       && request.resource.data.uid == requesterUid
                       && request.resource.data.status == 'pending'
                       && exists(/databases/$(database)/documents/couples/$(coupleId))
                       && !(request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members);

        // O solicitante vê o próprio pedido; o dono vê todos.
        allow read: if request.auth != null
                     && (request.auth.uid == requesterUid || request.auth.uid == coupleId);

        // O dono aprova ou recusa (muda só o status).
        allow update: if request.auth != null
                       && request.auth.uid == coupleId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                       && request.resource.data.status in ['approved', 'rejected'];

        // Solicitante (cancelar/encerrar) e dono (limpar) podem apagar.
        allow delete: if request.auth != null
                       && (request.auth.uid == requesterUid || request.auth.uid == coupleId);
      }

      // Dados financeiros reais do casal — só quem está em "members"
      // (os pedidos de entrada têm regras próprias acima).
      match /{collection}/{docId} {
        allow read, write: if request.auth != null
                             && collection != 'joinRequests'
                             && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
      }
    }

    // Qualquer coisa fora dos padrões acima é negada por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
